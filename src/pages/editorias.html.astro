---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDateTime, groupBy, slugify, sortStories, storyUrl } from '../lib/news';
const stories = sortStories(await getCollection('articles'));
const groups = groupBy(stories, 'category');
const navItems = [{ href: '/', label: 'Capa' }, { href: '/editorias.html', label: 'Editorias', current: true }, { href: '/territorios.html', label: 'Territórios' }, { href: '/arquivo.html', label: 'Arquivo' }, ...[...groups.keys()].map((category) => ({ href: `#editoria-${slugify(category)}`, label: category }))];
---
<BaseLayout title="Editorias — O Vigia" description="Navegue pelas editorias de O Vigia e continue acompanhando assuntos de Porto Velho." canonicalPath="/editorias.html" tagline="Continue lendo por assunto." navItems={navItems}>
<main class="front-page"><section class="edition-intro"><p class="eyebrow">Navegação</p><h1>Editorias</h1><p class="edition-deck">Os assuntos aparecem conforme o acervo real. Não há seção vazia criada apenas para preencher a navegação.</p></section>
{[...groups.entries()].map(([category, items], index) => <section class="editorial-section" id={`editoria-${slugify(category)}`} aria-labelledby={`title-${index}`}><div class="section-heading"><div><p class="eyebrow">Editoria</p><h2 id={`title-${index}`}>{category}</h2></div><p class="section-note">{items.length} no acervo</p></div><div class="news-grid news-grid-section">{items.map((story) => <article class="news-card news-card-brief"><div class="card-header"><time datetime={story.data.published_at}>{formatDateTime(story.data.published_at)}</time></div><h3 class="card-title"><a href={storyUrl(story)}>{story.data.title}</a></h3><p class="card-excerpt">{story.data.description}</p><div class="card-metadata"><span class="source-badge">Fonte: {story.data.source_name}</span><a class="btn-provenance" href={story.data.source_url} rel="noopener noreferrer">Abrir fonte ↗</a></div></article>)}</div></section>)}
</main></BaseLayout>
