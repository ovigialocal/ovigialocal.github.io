---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicTerritoryCard from '../components/concepts/PublicTerritoryCard.astro';
import { storiesForTerritory, territoryUrl, type Territory } from '../lib/news';

const stories = await getCollection('articles');
const territories = (await getCollection('territories')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'pt-BR'));
const byKind = new Map<string, Territory[]>();
for (const territory of territories) {
  const items = byKind.get(territory.data.kind) ?? [];
  items.push(territory);
  byKind.set(territory.data.kind, items);
}
const kindOrder = ['estado', 'municipio', 'distrito', 'bairro'];
const orderedKinds = [...byKind.keys()].sort((a, b) => {
  const ai = kindOrder.indexOf(a); const bi = kindOrder.indexOf(b);
  return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi) || a.localeCompare(b, 'pt-BR');
});
const navItems = [{ href: '/', label: 'Capa' }, { href: '/editorias.html', label: 'Editorias' }, { href: '/territorios.html', label: 'Territórios', current: true }, { href: '/arquivo.html', label: 'Arquivo' }];
---
<BaseLayout title="Territórios — O Vigia" description="Navegue pela cobertura de O Vigia por territórios materializados e verificáveis." canonicalPath="/territorios.html" tagline="Continue lendo pelo lugar a que a notícia realmente se refere." navItems={navItems}>
  <main class="front-page">
    <section class="edition-intro" aria-labelledby="territories-title">
      <p class="eyebrow">Navegação territorial</p>
      <h1 id="territories-title">Territórios</h1>
      <p class="edition-deck">Cada item abaixo é um conceito `PublicTerritory` do bundle OKF. Bairro, distrito, município ou estado só ganha página quando existe como entidade publicada; o site não inventa território a partir de texto.</p>
    </section>
    {orderedKinds.map((kind, index) => <section class="editorial-section" aria-labelledby={`territory-kind-${index}`}>
      <div class="section-heading"><div><p class="eyebrow">Território</p><h2 id={`territory-kind-${index}`}>{kind}</h2></div><p class="section-note">{byKind.get(kind)?.length ?? 0} publicados</p></div>
      <div class="news-grid news-grid-section">{(byKind.get(kind) ?? []).map((territory) => <PublicTerritoryCard territory={territory} articleCount={storiesForTerritory(stories, territory).length} childCount={territories.filter((child) => child.data.parent_territory_id === territory.data.territory_id).length} />)}</div>
    </section>)}
    {territories.length === 0 && <section class="empty-edition"><h2>Nenhum território publicado.</h2></section>}
  </main>
</BaseLayout>
