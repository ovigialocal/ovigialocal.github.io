---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const editions = (await getCollection('editions')).filter((edition) => edition.data.status === 'active');
const registries = await getCollection('editionRegistry');
if (registries.length !== 1 || registries[0].data.registry_id !== 'main') throw new Error('PublicEditionRegistry deve conter exatamente o registry main');
const [registry] = registries;
---
<BaseLayout title="Escolha sua cidade — O Vigia" description="Escolha a edição local de O Vigia." canonicalPath="/" compact>
  <main class="edition-router" aria-labelledby="edition-router-title">
    <p class="chapeu">Edições locais</p>
    <h1 id="edition-router-title">Notícias perto de você.</h1>
    <p>Quando reconhecemos uma preferência anterior, abrimos essa edição. Na primeira visita, uma consulta aproximada por IP tenta encontrar a cidade; se ela falhar, Porto Velho é a edição inicial.</p>
    <nav aria-label="Escolher cidade">
      {editions.map((edition) => <a href={`${edition.data.path_prefix}/`} data-edition={edition.data.edition_id}><strong>{edition.data.name}</strong><span>{edition.data.state_code}</span></a>)}
    </nav>
    <noscript><p>Selecione uma cidade para continuar.</p></noscript>
  </main>
  <script type="application/json" data-edition-registry set:html={JSON.stringify({ editions: editions.map(({ data }) => data), policy: registry.data })}></script>
  <script>
    import { GEOIP_ENDPOINT, GEOIP_TIMEOUT_MS } from '../lib/geo';
    type BrowserEdition = { edition_id: string; path_prefix: string; geo_names: string[] };
    type BrowserRegistry = { editions: BrowserEdition[]; policy: { default_edition_id: string } };
    (async () => {
      const editionsRegistry = JSON.parse(document.querySelector('[data-edition-registry]')?.textContent || '{}') as BrowserRegistry;
      const registry = editionsRegistry.editions;
      const policy = editionsRegistry.policy;
      const editions = Object.fromEntries(registry.map((edition) => [edition.edition_id, `${edition.path_prefix}/`]));
      const cityEditions = Object.fromEntries(registry.flatMap((edition) => edition.geo_names.map((name) => [name.toLocaleLowerCase('pt-BR'), edition.edition_id])));
      const chooser = new URLSearchParams(location.search).has('escolher');
      const remembered = localStorage.getItem('vigia:edition');
      document.querySelectorAll<HTMLElement>('[data-edition]').forEach((link) => link.addEventListener('click', () => {
        if (link.dataset.edition) localStorage.setItem('vigia:edition', link.dataset.edition);
      }));
      if (chooser) return;
      if (remembered && editions[remembered]) return location.replace(editions[remembered]);

      let inferred: string | undefined;
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), GEOIP_TIMEOUT_MS);
      try {
        const response = await fetch(`${GEOIP_ENDPOINT}?fields=success,city`, { signal: controller.signal });
        const result = await response.json();
        const city = typeof result.city === 'string' ? result.city.toLocaleLowerCase('pt-BR') : '';
        if (result.success) inferred = cityEditions[city];
      } catch {}
      finally { clearTimeout(timeout); }

      const fallback = policy.default_edition_id;
      const edition = inferred && editions[inferred] ? inferred : fallback;
      const target = editions[edition];
      if (!target) throw new Error(`Edição pública desconhecida: ${edition}`);
      localStorage.setItem('vigia:edition', edition);
      location.replace(target);
    })();
  </script>
</BaseLayout>
<style>
  .edition-router { max-width: 52rem; min-height: 55vh; margin: auto; padding: var(--s-8) var(--s-6); }
  .edition-router h1 { max-width: 12ch; margin: var(--s-2) 0 var(--s-4); font-family: var(--font-display); font-size: clamp(2.8rem, 7vw, 5.4rem); line-height: .95; letter-spacing: -.04em; }
  .edition-router > p:not(.chapeu) { max-width: 38rem; color: var(--fg-muted); font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.55; }
  .edition-router nav { display: grid; margin-top: var(--s-6); border-top: var(--border-width) solid var(--fg-heading); }
  .edition-router nav a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: 1px solid var(--border); color: var(--fg-heading); text-decoration: none; }
  .edition-router nav strong { font-family: var(--font-display); font-size: 1.35rem; }
  .edition-router nav span { color: var(--fg-muted); font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; }
  .edition-router nav a:hover strong { color: var(--vermelho); }
</style>
