---
import { getCollection } from 'astro:content';
import { storyUrl, type Story } from '../../lib/news';

export async function getStaticPaths() {
  const stories = await getCollection('articles');
  return stories.map((story) => ({ params: { story_id: story.data.story_id }, props: { story } }));
}

const { story } = Astro.props as { story: Story };
return Astro.redirect(storyUrl(story), 301);
---
