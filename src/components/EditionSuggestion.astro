---
import { EDITIONS } from '../lib/editions';

interface Props { current: string }
const { current } = Astro.props;
---
<aside class="edition-suggestion" data-edition-suggestion data-current={current} data-editions={JSON.stringify(EDITIONS)} hidden>
  <p><span data-suggestion-copy></span> <a data-suggestion-link>Mudar de edição →</a></p>
</aside>
<script>
  const suggestion = document.querySelector<HTMLElement>('[data-edition-suggestion]');
  if (suggestion) {
    const editions = JSON.parse(suggestion.dataset.editions ?? '[]');
    const current = suggestion.dataset.current;
    const distance = (a: number, b: number, c: number, d: number) => {
      const rad = (value: number) => value * Math.PI / 180;
      const x = Math.sin(rad(c - a) / 2) ** 2 + Math.cos(rad(a)) * Math.cos(rad(c)) * Math.sin(rad(d - b) / 2) ** 2;
      return 6371 * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
    };
    const recommend = async () => {
      if (editions.length < 2) return;
      let geo;
      try {
        geo = JSON.parse(sessionStorage.getItem('vigia:geo') ?? 'null');
        if (!geo) {
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 1800);
          const response = await fetch('https://ipwho.is/?fields=success,latitude,longitude', { signal: controller.signal });
          clearTimeout(timeout);
          const result = await response.json();
          if (!result.success) return;
          geo = { latitude: result.latitude, longitude: result.longitude };
          sessionStorage.setItem('vigia:geo', JSON.stringify(geo));
        }
      } catch { return; }
      const nearby = editions.map((edition: any) => ({ ...edition, distance: distance(geo.latitude, geo.longitude, edition.latitude, edition.longitude) })).sort((a: any, b: any) => a.distance - b.distance)[0];
      if (!nearby || nearby.slug === current || nearby.distance > 250) return;
      const copy = suggestion.querySelector<HTMLElement>('[data-suggestion-copy]');
      const link = suggestion.querySelector<HTMLAnchorElement>('[data-suggestion-link]');
      if (!copy || !link) return;
      copy.textContent = `Você parece estar mais perto de ${nearby.name}.`;
      link.href = `/${nearby.slug}/`;
      link.addEventListener('click', () => localStorage.setItem('vigia:edition', nearby.slug));
      suggestion.hidden = false;
    };
    recommend();
  }
</script>
