<div class="modal-overlay" id="modal-provenance" role="dialog" aria-modal="true" aria-labelledby="modal-provenance-title" hidden>
  <div class="modal-card">
    <button type="button" class="modal-close" id="modal-close" aria-label="Fechar modal">&times;</button>
    <div id="modal-content"></div>
  </div>
</div>
<script>
  const modal = document.getElementById('modal-provenance');
  const content = document.getElementById('modal-content');
  const close = () => {
    if (!modal) return;
    modal.setAttribute('hidden', 'true');
    modal.classList.remove('active');
  };
  document.querySelectorAll<HTMLElement>('[data-provenance-button]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!modal || !content) return;
      const title = document.createElement('h2');
      title.id = 'modal-provenance-title';
      title.textContent = button.dataset.title || 'Fonte da matéria';
      const box = document.createElement('div');
      box.className = 'provenance-box';
      const source = document.createElement('div');
      source.className = 'provenance-item';
      source.innerHTML = '<strong>Fonte: </strong>';
      source.append(document.createTextNode(button.dataset.sourceName || ''));
      box.append(source);
      if (button.dataset.sourceHash) {
        const ref = document.createElement('div');
        ref.className = 'provenance-item';
        ref.innerHTML = '<strong>Referência: </strong>';
        ref.append(document.createTextNode(button.dataset.sourceHash));
        box.append(ref);
      }
      if (button.dataset.sourceUrl) {
        const link = document.createElement('a');
        link.className = 'provenance-source-link';
        link.href = button.dataset.sourceUrl;
        link.rel = 'noopener noreferrer';
        link.textContent = 'Abrir fonte verificável ↗';
        box.append(link);
      }
      content.replaceChildren(title, box);
      modal.removeAttribute('hidden');
      modal.classList.add('active');
      document.getElementById('modal-close')?.focus();
    });
  });
  document.getElementById('modal-close')?.addEventListener('click', close);
  modal?.addEventListener('click', (event) => { if (event.target === modal) close(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
</script>
