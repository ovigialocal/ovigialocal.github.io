---
import type { CollectionEntry } from 'astro:content';
import { formatDateTime, slugify, storyUrl } from '../../lib/news';
import SourceDisclosure from '../SourceDisclosure.astro';

interface Props {
  story: CollectionEntry<'articles'>;
  showCategory?: boolean;
  showSource?: boolean;
  sourceMode?: 'modal' | 'link';
}

const { story, showCategory = true, showSource = true, sourceMode = 'modal' } = Astro.props;
---
<article class="news-card news-card-brief" data-news-card data-category={story.data.category} data-bairro={story.data.bairro ?? story.data.locality}>
  <div class="card-header">
    {showCategory && <a class="badge-tag" href={`/editorias.html#editoria-${slugify(story.data.category)}`}>{story.data.category}</a>}
    <time datetime={story.data.published_at}>{formatDateTime(story.data.published_at)}</time>
  </div>
  <h3 class="card-title"><a href={storyUrl(story)}>{story.data.title}</a></h3>
  <p class="card-excerpt">{story.data.chamada ?? story.data.description}</p>
  {showSource && <SourceDisclosure story={story} mode={sourceMode} />}
</article>
