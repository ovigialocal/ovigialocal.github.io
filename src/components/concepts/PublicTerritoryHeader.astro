---
import type { CollectionEntry } from 'astro:content';

interface Props {
  territory: CollectionEntry<'territories'>;
  parent?: CollectionEntry<'territories'>;
  articleCount: number;
}

const { territory, parent, articleCount } = Astro.props;
---
<header class="edition-intro territory-header">
  <p class="eyebrow">{territory.data.kind}</p>
  <h1>{territory.data.name}</h1>
  <p class="edition-deck">{territory.data.description}</p>
  <p class="section-note">
    {parent && <>Parte de <a href={`/territorios/${parent.data.territory_id}/`}>{parent.data.name}</a> · </>}
    {articleCount} {articleCount === 1 ? 'matéria publicada' : 'matérias publicadas'}
  </p>
</header>
