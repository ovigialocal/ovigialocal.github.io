---
layout: null
---
{% assign sorted_news = site.news | sort: "published_at" | reverse %}
[
{% for story in sorted_news %}
  {
    "id": {{ story.story_id | jsonify }},
    "category": {{ story.category | jsonify }},
    "bairro": {{ story.bairro | default: "" | jsonify }},
    "date": {{ story.published_at | date: "%d/%m" | jsonify }},
    "dateIso": {{ story.published_at | date_to_xmlschema | jsonify }},
    "title": {{ story.title | jsonify }},
    "excerpt": {{ story.description | jsonify }},
    "deck": {{ story.description | jsonify }},
    "sourceName": {{ story.source_name | jsonify }},
    "sourceUrl": {{ story.source_url | jsonify }},
    "sourceHash": {{ story.source_digest | jsonify }},
    "neighborhood": {{ story.locality | jsonify }},
    "url": {{ story.url | relative_url | jsonify }},
    "contentHtml": {{ story.content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
