---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc><changefreq>daily</changefreq></url>
  {% assign sorted_news = site.news | sort: "published_at" | reverse %}
  {% for story in sorted_news %}
  <url>
    <loc>{{ story.url | absolute_url }}</loc>
    <lastmod>{{ story.updated_at | default: story.published_at | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>daily</changefreq>
  </url>
  {% endfor %}
</urlset>
