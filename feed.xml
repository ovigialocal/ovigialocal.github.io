---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>O Vigia — Porto Velho</title>
    <link>{{ '/' | absolute_url }}</link>
    <description>Feed do projeto O Vigia em Porto Velho (RO)</description>
    <language>pt-BR</language>
    {% assign sorted_news = site.news | sort: "published_at" | reverse %}
    {% for story in sorted_news %}
    <item>
      <title>{{ story.title | xml_escape }}</title>
      <link>{{ story.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ story.url | absolute_url }}</guid>
      <pubDate>{{ story.published_at | date_to_rfc822 }}</pubDate>
      <category>{{ story.category | xml_escape }}</category>
      <description>{{ story.description | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
